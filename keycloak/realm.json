{
  "realm": "lab",
  "enabled": true,
  "adminPermissionsEnabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clientScopes": [
    {
      "name": "basic", "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "false", "display.on.consent.screen": "false"},
      "protocolMappers": [{"name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper",
        "config": {"introspection.token.claim": "true", "access.token.claim": "true"}}]
    },
    {
      "name": "profile", "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true"},
      "protocolMappers": [
        {"name": "username", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
         "config": {"user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String",
                    "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}},
        {"name": "full name", "protocol": "openid-connect", "protocolMapper": "oidc-full-name-mapper",
         "config": {"access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}}
      ]
    },
    {
      "name": "email", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"},
      "protocolMappers": [{"name": "email", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
        "config": {"user.attribute": "email", "claim.name": "email", "jsonType.label": "String",
                   "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}}]
    },
    {"name": "roles", "protocol": "openid-connect"},
    {"name": "web-origins", "protocol": "openid-connect"},
    {
      "name": "delegation:client", "protocol": "openid-connect",
      "description": "OpenID Connect scope for agent/client token exchange delegation",
      "attributes": {"include.in.token.scope": "true", "parameterized.scope.type": "client-delegation",
                     "display.on.consent.screen": "true", "always.display.consent": "true",
                     "is.parameterized.scope": "true", "consent.screen.text": "${clientDelegationScopeConsentText}"},
      "protocolMappers": [
        {"name": "client delegation audience", "protocol": "openid-connect", "protocolMapper": "oidc-parameterized-scope-audience-mapper",
         "config": {"introspection.token.claim": "true", "access.token.claim": "true"}},
        {"name": "client may_act client_id", "protocol": "openid-connect", "protocolMapper": "oidc-parameterized-scope-mapper",
         "config": {"id.token.claim": "true", "introspection.token.claim": "true", "access.token.claim": "true",
                    "claim.name": "may_act.client_id", "jsonType.label": "String"}},
        {"name": "client may_act sub", "protocol": "openid-connect", "protocolMapper": "oidc-parameterized-scope-client-sub-mapper",
         "config": {"id.token.claim": "true", "introspection.token.claim": "true", "access.token.claim": "true",
                    "claim.name": "may_act.sub", "jsonType.label": "String"}}
      ]
    },
    {
      "name": "primary-audience", "protocol": "openid-connect",
      "protocolMappers": [{"name": "primary-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
        "config": {"included.client.audience": "primary-agent", "access.token.claim": "true", "id.token.claim": "false"}}]
    },
    {
      "name": "finance-agent-audience", "protocol": "openid-connect",
      "protocolMappers": [{"name": "finance-agent-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
        "config": {"included.client.audience": "finance-agent", "access.token.claim": "true", "id.token.claim": "false"}}]
    },
    {
      "name": "finance-api-audience", "protocol": "openid-connect",
      "protocolMappers": [{"name": "finance-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
        "config": {"included.client.audience": "finance-api", "access.token.claim": "true", "id.token.claim": "false"}}]
    },
    {"name": "invoices.read", "protocol": "openid-connect"},
    {"name": "invoices.write", "protocol": "openid-connect"},
    {"name": "payments.read", "protocol": "openid-connect"},
    {"name": "payments.approve", "protocol": "openid-connect"}
  ],
  "clients": [
    {
      "clientId": "librechat", "enabled": true, "protocol": "openid-connect", "publicClient": false,
      "secret": "lab-librechat-secret", "standardFlowEnabled": true, "consentRequired": true,
      "redirectUris": ["http://localhost:3080/oauth/openid/callback"],
      "webOrigins": ["http://localhost:3080"],
      "defaultClientScopes": ["basic", "profile", "email", "roles", "web-origins"],
      "optionalClientScopes": ["delegation:client", "primary-audience"]
    },
    {
      "clientId": "primary-agent", "enabled": true, "protocol": "openid-connect", "publicClient": false,
      "secret": "lab-primary-secret", "serviceAccountsEnabled": true, "standardFlowEnabled": false,
      "consentRequired": true,
      "attributes": {"oauth2.device.authorization.grant.enabled": "true"},
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["delegation:client", "finance-agent-audience"]
    },
    {
      "clientId": "finance-agent", "enabled": true, "protocol": "openid-connect", "publicClient": false,
      "secret": "lab-finance-agent-secret", "serviceAccountsEnabled": true, "standardFlowEnabled": false,
      "attributes": {"standard.token.exchange.enabled": "true"},
      "defaultClientScopes": ["basic", "profile", "finance-api-audience", "invoices.read", "invoices.write", "payments.read"]
    },
    {"clientId": "finance-api", "enabled": true, "protocol": "openid-connect", "bearerOnly": true}
  ],
  "users": [
    {"id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "username": "alice", "enabled": true, "email": "alice@example.test",
      "firstName": "Alice", "lastName": "Demo", "emailVerified": true,
      "credentials": [{"type": "password", "value": "alice-lab", "temporary": false}]},
    {"id": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", "username": "bob", "enabled": true, "email": "bob@example.test",
      "firstName": "Bob", "lastName": "Demo", "emailVerified": true,
      "credentials": [{"type": "password", "value": "bob-lab", "temporary": false}]}
  ]
}
